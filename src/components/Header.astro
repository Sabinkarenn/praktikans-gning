---
import Logo from "../assets/images/logo.png";
---

<header
  class="font-body
         fixed
         top-0
         left-0
         w-full
         bg-primaryblue20
         border-b-2
         border-orange60
         py-4
         px-6
         z-50"
>
  <div class="w-full flex items-center justify-between relative min-h-[44px]">
    <!-- =========================
     LOGO - VENSTRE
========================== -->
    <a
      href="/"
      class="flex
         items-center
         transition
         duration-300
         hover:opacity-60"
      aria-label="Go to homepage"
    >
      <img
        src={Logo.src}
        alt="Sabina Khan Nielsen logo"
        class="block
           w-auto
           h-10
           sm:h-11"
      />
    </a>

    <!-- =========================
         DESKTOP NAVIGATION
    ========================== -->
    <nav
      class="hidden lg:flex
             items-center
             justify-end
             gap-3"
    >
      <!-- About me -->
      <a
        href="#about-me"
        class="scroll-link
               bg-white
               text-orange60
               border-2 border-orange60
               px-6 py-2
               text-sm
               font-bold
               uppercase
               tracking-[0.18em]
               transition duration-300
               hover:bg-orange60
               hover:text-white"
      >
        About me
      </a>

      <!-- Projects -->
      <a
        href="#projects"
        class="scroll-link
               bg-white
               text-orange60
               border-2 border-orange60
               px-6 py-2
               text-sm
               font-bold
               uppercase
               tracking-[0.18em]
               transition duration-300
               hover:bg-orange60
               hover:text-white"
      >
        Projects
      </a>

      <!-- CV - CTA -->
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-orange60
         text-white
         border-2 border-orange60
         px-6 py-2
         text-sm
         font-bold
         uppercase
         tracking-[0.18em]
         transition duration-300
         hover:bg-white
         hover:text-orange60"
      >
        CV
      </a>
    </nav>

    <!-- =========================
         BURGER MENU
    ========================== -->
    <button
      id="menu-toggle"
      class="lg:hidden flex flex-col gap-1.5"
      aria-label="Open menu"
    >
      <span class="w-7 h-0.5 bg-orange60"></span>
      <span class="w-7 h-0.5 bg-orange60"></span>
      <span class="w-7 h-0.5 bg-orange60"></span>
    </button>
  </div>

  <!-- =========================
       MOBILE MENU
  ========================== -->
  <div
    id="mobile-menu"
    class="fixed inset-0
           bg-primaryblue20
           z-[60]
           translate-x-full
           transition-transform
           duration-300
           lg:hidden"
  >
    <!-- Logo i mobilmenu -->
    <a
      href="/"
      class="absolute
             top-6
             left-6
             transition
             duration-300
             hover:opacity-60"
      aria-label="Go to homepage"
    >
      <img
        src={Logo.src}
        alt="Sabina Khan Nielsen logo"
        class="block
               w-auto
               h-8"
      />
    </a>

    <!-- Close -->
    <button
      id="close-menu"
      class="absolute
             top-6
             right-6
             text-orange60
             text-4xl
             font-light"
      aria-label="Close menu"
    >
      ×
    </button>

    <!-- Mobile navigation -->
    <nav
      class="h-full
             flex
             flex-col
             items-center
             justify-center
             gap-4
             px-6"
    >
      <!-- About me -->
      <a
        href="#about-me"
        class="scroll-link mobile-link
               w-full max-w-xs
               text-center
               bg-white
               text-orange60
               border-2 border-orange60
               px-6 py-3
               text-base
               font-bold
               uppercase
               tracking-[0.18em]
               transition duration-300
               hover:bg-orange60
               hover:text-white"
      >
        About me
      </a>

      <!-- Projects -->
      <a
        href="#projects"
        class="scroll-link mobile-link
               w-full max-w-xs
               text-center
               bg-white
               text-orange60
               border-2 border-orange60
               px-6 py-3
               text-base
               font-bold
               uppercase
               tracking-[0.18em]
               transition duration-300
               hover:bg-orange60
               hover:text-white"
      >
        Projects
      </a>

      <!-- CV -->
      <a
        href="/cv.pdf"
        target="_blank"
        class="w-full max-w-xs
               text-center
               bg-orange60
               text-white
               border-2 border-orange60
               px-6 py-3
               text-base
               font-bold
               uppercase
               tracking-[0.18em]
               transition duration-300
               hover:bg-white
               hover:text-orange60"
      >
        CV
      </a>
    </nav>
  </div>

  <!-- =========================
       JAVASCRIPT
  ========================== -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const menuToggle = document.getElementById("menu-toggle");
      const closeMenu = document.getElementById("close-menu");
      const menu = document.getElementById("mobile-menu");
      const mobileLinks = document.querySelectorAll(".mobile-link");

      // Open mobile menu
      if (menuToggle && menu) {
        menuToggle.addEventListener("click", function () {
          menu.classList.remove("translate-x-full");
        });
      }

      // Close mobile menu
      if (closeMenu && menu) {
        closeMenu.addEventListener("click", function () {
          menu.classList.add("translate-x-full");
        });
      }

      // Close mobile menu after clicking a link
      mobileLinks.forEach((link) => {
        link.addEventListener("click", function () {
          if (menu) {
            menu.classList.add("translate-x-full");
          }
        });
      });

      // Smooth scroll
      document.querySelectorAll(".scroll-link").forEach((link) => {
        link.addEventListener("click", function (e) {
          e.preventDefault();

          const href = this.getAttribute("href");

          if (!href) return;

          const targetId = href.substring(1);

          const targetElement = document.querySelector(
            `#${targetId} .scroll-target`,
          );

          if (targetElement) {
            const headerOffset = 90;

            const elementPosition =
              targetElement.getBoundingClientRect().top + window.scrollY;

            window.scrollTo({
              top: elementPosition - headerOffset,
              behavior: "smooth",
            });
          }
        });
      });
    });
  </script>
</header>
