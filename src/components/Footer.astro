---
import Logo from "../assets/images/logo.png";
---

<footer
  class="font-sans
         w-full
         bg-primaryblue20
         border-t-2
         border-orange60
         px-6
         sm:px-10
         lg:px-12
         py-6"
>
  <div
    class="max-w-screen-2xl
           mx-auto
           flex
           flex-col
           sm:flex-row
           sm:items-center
           sm:justify-between
           gap-5"
  >
    <!-- =========================
         LOGO - VENSTRE
    ========================== -->
    <a
      href="/"
      class="flex
             items-center
             transition
             duration-300
             hover:opacity-60"
      aria-label="Go to homepage"
    >
      <img
        src={Logo.src}
        alt="Sabina Khan Nielsen logo"
        class="block
               w-auto
               h-10
               sm:h-11"
      />
    </a>

    <!-- LINKS -->
    <div
      class="flex
             items-center
             flex-wrap
             gap-5
             sm:gap-6"
    >
      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/sabinakhannielsen/"
        target="_blank"
        rel="noopener noreferrer"
        class="group
               flex
               items-center
               gap-1.5
               text-xs
               sm:text-sm
               font-bold
               tracking-[0.15em]
               text-orange60
               uppercase
               transition
               duration-300
               hover:opacity-60"
      >
        LinkedIn

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="w-3.5
                 h-3.5
                 transition-transform
                 duration-200
                 group-hover:translate-x-0.5
                 group-hover:-translate-y-0.5"
          aria-hidden="true"
        >
          <path d="M7 17L17 7"></path>
          <path d="M7 7h10v10"></path>
        </svg>
      </a>

      <!-- EMAIL -->
      <a
        href="mailto:sabina.nielsen11@gmail.com"
        class="group
               flex
               items-center
               gap-1.5
               text-xs
               sm:text-sm
               font-bold
               tracking-[0.15em]
               text-orange60
               uppercase
               transition
               duration-300
               hover:opacity-60"
      >
        Email

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="w-3.5
                 h-3.5
                 transition-transform
                 duration-200
                 group-hover:translate-x-0.5
                 group-hover:-translate-y-0.5"
          aria-hidden="true"
        >
          <path d="M7 17L17 7"></path>
          <path d="M7 7h10v10"></path>
        </svg>
      </a>

      <!-- CV -->
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="group
               flex
               items-center
               gap-1.5
               text-xs
               sm:text-sm
               font-bold
               tracking-[0.15em]
               text-orange60
               uppercase
               transition
               duration-300
               hover:opacity-60"
      >
        CV

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="w-3.5
                 h-3.5
                 transition-transform
                 duration-200
                 group-hover:translate-x-0.5
                 group-hover:-translate-y-0.5"
          aria-hidden="true"
        >
          <path d="M7 17L17 7"></path>
          <path d="M7 7h10v10"></path>
        </svg>
      </a>
    </div>

    <!-- PORTFOLIO -->
    <p
      class="text-[10px]
             sm:text-xs
             tracking-[0.1em]
             text-orange60
             opacity-70"
    >
      Sabina Khan Nielsen 2026
    </p>
  </div>
</footer>
