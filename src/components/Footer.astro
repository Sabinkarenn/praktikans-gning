---
import Logo from "../assets/images/logo.png";
---

<footer
  class="font-sans
         w-full
         bg-primaryblue20
         border-t-2
         border-orange60
         px-6
         sm:px-10
         lg:px-12
         py-6"
>
  <div
    class="max-w-screen-2xl
           mx-auto
           flex
           flex-col
           sm:flex-row
           sm:items-center
           sm:justify-between
           gap-5"
  >
    <!-- =========================
     LOGO - VENSTRE
========================== -->
    <a
      href="/"
      class="flex
         items-center
         transition
         duration-300
         hover:opacity-60"
      aria-label="Go to homepage"
    >
      <img
        src={Logo.src}
        alt="Sabina Khan Nielsen logo"
        class="block
           w-auto
           h-10
           sm:h-11"
      />
    </a>

    <!-- Links -->
    <div
      class="flex
             items-center
             flex-wrap
             gap-5
             sm:gap-6"
    >
      <a
        href="https://www.linkedin.com/in/sabinakhannielsen/"
        target="_blank"
        class="text-xs
               sm:text-sm
               font-bold
               tracking-[0.15em]
               text-orange60
               uppercase
               transition
               duration-300
               hover:opacity-60"
      >
        LinkedIn ↗
      </a>

      <a
        href="mailto:sabina.nielsen11@gmail.com"
        class="text-xs
               sm:text-sm
               font-bold
               tracking-[0.15em]
               text-orange60
               uppercase
               transition
               duration-300
               hover:opacity-60"
      >
        Email ↗
      </a>

      <a
        href="/cv.pdf"
        target="_blank"
        class="text-xs
               sm:text-sm
               font-bold
               tracking-[0.15em]
               text-orange60
               uppercase
               transition
               duration-300
               hover:opacity-60"
      >
        CV ↗
      </a>
    </div>

    <!-- Portfolio -->
    <p
      class="text-[10px]
             sm:text-xs
             tracking-[0.1em]
             text-orange60
             
             opacity-70"
    >
      Sabina Khan Nielsen 2026
    </p>
  </div>
</footer>
